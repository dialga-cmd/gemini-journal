# =====================================================================
# Personal Gemini Journal — environment template
#
#   cp .env.local.example .env.local   then fill in every value below.
#
# Two groups live here: public-by-design web config, and SERVER-ONLY
# secrets. Nothing in this file may ever move into a NEXT_PUBLIC_*
# variable except the six web-config values shown below.
# .env.local is gitignored — this example file is the only one committed.
# =====================================================================

# ---------------------------------------------------------------------
# GROUP 1 — Firebase web config (public by design)
# Protection comes from Firestore rules + authorized domains, NOT from
# config secrecy. Source: Firebase console → Project settings →
# General → Your apps → Web app → SDK setup and configuration.
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------
# GROUP 2 — SERVER ONLY. Read exclusively by server-side code
# (API route handlers / Admin SDK context). Never bundled to the client.
# ---------------------------------------------------------------------

# Firebase Admin service-account JSON ("service account key" downloaded
# from Project settings → Service accounts). Path relative to project
# root. The file itself must stay out of version control.
FIREBASE_SERVICE_ACCOUNT_PATH=service-key.json

# Gemini API key. Source: Google AI Studio → "Get API key".
GEMINI_API_KEY=

# Model override. Free tier: flash-lite cheapest, flash higher quality.
# Note: pinned versions get retired for new accounts — if you hit a 404
# "no longer available", check ListModels and move up a generation.
GEMINI_MODEL=gemini-3.5-flash-lite
