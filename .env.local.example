# ============================================================
# CLIENT-SIDE CONFIG (copied to .env.local)
# These NEXT_PUBLIC_ values are NOT secrets — the Firebase web
# config is public by design. Real protection = security rules +
# authorized domains. Never put real credentials down here.
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================
# SERVER-ONLY — never referenced from client code, never committed
# (.env.local is gitignored).
# ============================================================

# GCP project holding the Gemini key in Secret Manager.
GOOGLE_CLOUD_PROJECT=

# Secret Manager resource ID (not the value!) of the Gemini key.
GEMINI_API_SECRET_ID=gemini-api-key

# Model override. Free tier: flash-lite cheapest, flash higher quality.
GEMINI_MODEL=gemini-2.5-flash-lite

# LOCAL DEV ONLY: fallback when Secret Manager isn't reachable from your
# laptop. Deployed environments MUST use Secret Manager instead.
# GEMINI_API_KEY=

# LOCAL DEV ONLY: path to a service-account JSON for firebase-admin
# (gitignored). On Cloud Run / deployed infra, ADC provides this automatically.
# GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json
